# ===========================================
# AI Agent Gradio - 環境変数設定
# ===========================================
# このファイルを .env にコピーして使用してください
# cp .env.example .env

# ===========================================
# OpenAI API設定（必須）
# ===========================================

# OpenAI APIキー
# 取得方法: https://platform.openai.com/api-keys
# 形式: sk-で始まる文字列
OPENAI_API_KEY=your-api-key-here

# ===========================================
# モデル設定
# ===========================================

# 使用するOpenAIモデル
# 選択肢: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
# 推奨: gpt-4o（高性能・コスト効率）
MODEL_NAME=gpt-4o

# エージェント間の最大メッセージ数
# この数に達すると会話が自動的に終了します
# 推奨範囲: 50-200
MAX_MESSAGES=80

# ===========================================
# サーバー設定
# ===========================================

# Gradioサーバーのポート番号
SERVER_PORT=7860

# 公開リンクを生成するかどうか
# true: インターネット経由でアクセス可能な一時URLを生成
# false: ローカルネットワークのみでアクセス可能（推奨）
# 注意: 本番環境では false を推奨
SHARE=false
